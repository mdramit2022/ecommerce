# ── Database ────────────────────────────────────────────────────────────
# docker-compose.yml exposes Postgres on host port 5436.
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/ecommerce?schema=public"

# ── Auth.js / NextAuth v5 ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Optional OAuth (leave unset to disable Google sign-in)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Stripe ─────────────────────────────────────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
# The app treats values containing REPLACE_ME as "payments not configured".
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# ── Email (optional, https://resend.com) ───────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="Ecommerce <orders@yourdomain.com>"

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
